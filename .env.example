# Copy to .env — read by docker compose. Never commit the real file.
POSTGRES_DB=furniture_store
POSTGRES_USER=furniture
# Matches the local default in backend/src/FurnitureStore.Api/appsettings.Development.json.
# Change both (or set ConnectionStrings__Store) for anything that isn't your own machine.
# Postgres only reads this when it first creates the volume; after that, `docker compose down -v` to reset.
POSTGRES_PASSWORD=furniture_dev
POSTGRES_PORT=5432
WEB_PORT=8080

# Optional: create an admin account on first start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# "Development" records orders without taking payment. Leave empty to disable checkout.
PAYMENTS_PROVIDER=Development
